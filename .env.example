# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cargo_delivery?schema=public"

# Auth
JWT_SECRET="replace-with-strong-secret"
OTP_EXPIRY_SECONDS=300

# Object Storage (S3 / Cloudflare R2 for private Bilty & ID images)
S3_BUCKET="cargo-private-docs"
S3_REGION="auto"
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
SIGNED_URL_TTL_SECONDS=60

# API
PORT=3001
